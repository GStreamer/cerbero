From dfeaacb9d879eb7e9c4ba640468c304e2461edce Mon Sep 17 00:00:00 2001
From: Luca Bacci <luca.bacci982@gmail.com>
Date: Tue, 22 Sep 2026 11:43:39 +0200
Subject: [PATCH 2/2] Win32: Fix build with DWrite disabled

(cherry picked from commit a1718af9e33bd33a717a1327cfa319790beba937)
---
 src/win32/cairo-win32-system.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/win32/cairo-win32-system.c b/src/win32/cairo-win32-system.c
index 8f24150bd..c7d2ebd40 100644
--- a/src/win32/cairo-win32-system.c
+++ b/src/win32/cairo-win32-system.c
@@ -52,6 +52,12 @@
 
 #include <stdbool.h>
 
+#if _WIN32_WINNT < _WIN32_WINNT_WIN8
+
+DECLARE_HANDLE(CO_MTA_USAGE_COOKIE);
+
+#endif
+
 typedef HRESULT (__stdcall *pCoIncrementMTAUsage_t) (CO_MTA_USAGE_COOKIE*);
 typedef HRESULT (__stdcall *pCoDecrementMTAUsage_t) (CO_MTA_USAGE_COOKIE);
 
@@ -248,7 +254,9 @@ cairo_win32_initialize (void)
 static void
 cairo_win32_finalize (void)
 {
+#if CAIRO_HAS_DWRITE_FONT
     cairo_win32_dwrite_finalize ();
+#endif
     cairo_win32_thread_data_finalize ();
     cairo_win32_mta_finalize ();
     CAIRO_MUTEX_FINALIZE ();
-- 
2.55.0

