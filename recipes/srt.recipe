# -*- Mode: Python -*- vi:si:et:sw=4:sts=4:ts=4:syntax=python

from cerbero.tools.libtool import LibtoolLibrary

import shutil


class Recipe(recipe.Recipe):
    name = 'srt'
    version = '1.5.6'
    url = 'https://github.com/Haivision/srt/archive/v%(version)s.tar.gz'
    tarball_checksum = '788a36c6739d9d2076ea53a4021ad36ab421a671eca4a79c8d7ca68257cc03a3'
    licenses = [License.MPLv2]
    stype = SourceType.TARBALL
    btype = BuildType.CMAKE
    can_msvc = True
    # compatibility is set to 2.8.12
    configure_options = [
        '-DUSE_ENCLIB=openssl',
        '-DENABLE_APPS=OFF',
        '-DCMAKE_POLICY_VERSION_MINIMUM=3.5'
    ]
    deps = ['openssl']

    patches = [
        'srt/0001-cmake-Fix-exception-handling-mode-on-MSVC.patch',
        'srt/0002-Add-static-Win32-build.patch',
    ]

    files_libs = ['libsrt']
    files_devel = ['include/srt', '%(libdir)s/pkgconfig/srt.pc']

    def prepare(self):
        if self.config.target_platform == Platform.ANDROID:
            self.append_env('CXXFLAGS', '-frtti', '-fexceptions')

    async def install(self):
        await super(recipe.Recipe, self).install()
        # This step must be idempotent, hence why it's done here
        if self.using_msvc():
            shutil.move(
                    os.path.join(self.config.libdir, 'srt_static.lib'),
                    os.path.join(self.config.libdir, 'libsrt.a'))

    def post_install(self):
        libtool_la = LibtoolLibrary('srt', None, None, None, self.config.libdir,
                self.config.target_platform, deps=['ssl', 'crypto'])
        libtool_la.save()
        super().post_install()
