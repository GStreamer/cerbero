# -*- Mode: Python -*- vi:si:et:sw=4:sts=4:ts=4:syntax=python
from cerbero.enums import Symbolication
from cerbero.tools.libtool import LibtoolLibrary

from pathlib import Path
import shutil


class Mpg123Base:
    version = '1.33.7'
    stype = SourceType.TARBALL
    btype = BuildType.CMAKE
    url = 'https://www.mpg123.de/download/mpg123-%(version)s.tar.bz2'
    tarball_checksum = '31d0e35a4ca567ec9b5ebda6c3062bb4435d6d3eacd6ef0d95cadd7854dc03ee'
    tarball_dirname = 'mpg123-%(version)s'
    library_type = LibraryType.STATIC
    can_msvc = True

    configure_options = [
        '-DUSE_MODULES=OFF',
        '-DBUILD_PROGRAMS=OFF',
        '-DBUILD_LIBOUT123=OFF',
        '-DCMAKE_DISABLE_FIND_PACKAGE_ALSA=ON',
        '-DCMAKE_DISABLE_FIND_PACKAGE_PkgConfig=ON',
    ]

    def prepare(self):
        self.config_src_dir = os.path.join(self.src_dir, 'ports', 'cmake')
        if self.config.target_platform == Platform.WINDOWS:
            # WIN32 is not set under Ninja and is used to enable exports
            self.append_env('CFLAGS', '-DWIN32=1')
        if self.config.target_arch == Architecture.X86 and self.config.variants.mingw:
                    self.append_env('ASMFLAGS', '-m32')


class Mpg123StaticRecipe(Mpg123Base, recipe.Recipe):
    name = 'mpg123-static'
    files_libs = ['libmpg123']

    def prepare(self):
        super().prepare()

    async def install(self):
        for lib in self.files_libs:
            name = f"{lib.removeprefix('lib')}.lib" if self.using_msvc() else f'{lib}.a'
            src = Path(self.build_dir) / 'src' / 'libmpg123' / name
            dest = Path(self.config.libdir) / f'{lib}.a'
            shutil.copy(src, dest)


class Mpg123Recipe(Mpg123Base, recipe.Recipe):
    name = 'mpg123'
    # CMake will ignore the BUILD_STATIC_LIBS bit, which has been completed
    # by the recipe above
    library_type = LibraryType.BOTH
    # Complete the licenses with the BOTH recipe
    licenses = [{License.LGPLv2_1Plus: ['COPYING']}]
    deps = ['mpg123-static']

    files_libs = ['libmpg123']
    files_devel = ['include/mpg123.h', 'include/fmt123.h', '%(libdir)s/pkgconfig/libmpg123.pc']

    def prepare(self):
        super().prepare()
        if self.using_msvc():
            self.symbolication_patterns = {
                Symbolication.SKIP: [],
                Symbolication.MANUAL: ['mpg123']
            }


    def post_install(self):
        libtool_la = LibtoolLibrary('mpg123', None, None, None, self.config.libdir,
                self.config.target_platform)
        libtool_la.save()
        super().post_install()
