# -*- Mode: Python -*- vi:si:et:sw=4:sts=4:ts=4:syntax=python
from cerbero.tools.libtool import LibtoolLibrary


class Recipe(recipe.Recipe):
    version = '0.165.3223+git20250910.0480cb0'
    name = 'x264'
    stype = SourceType.TARBALL
    btype = BuildType.MESON
    # The snapshotting service is discontinued.
    # However, there's no pinned tag for each stable commit.
    # See https://download.videolan.org/pub/x264/snapshots/x264-snapshot-20191218-README.txt
    # Patch and tarball must match the below port (keeping it for reference)
    # remotes = {'origin': 'https://gitlab.freedesktop.org/gstreamer/meson-ports/%(name)s.git'}
    # commit = 'origin/165.3223-meson'
    # Source url = 'https://deb.debian.org/debian/pool/main/x/x264/x264_%(version)s.orig.tar.xz'
    url = 'https://deb.debian.org/debian/pool/main/x/x264/x264_%(version)s.orig.tar.xz'
    tarball_checksum = 'de68ca43d0c6e09baeb86a38ed5cde86b0a84a21d6babcc569804201dc9df133'

    licenses = [License.GPLv2Plus]

    patches = [
        'x264/0001-Add-Meson-build.patch',
        # https://gitlab.freedesktop.org/gstreamer/meson-ports/x264/-/merge_requests/36
        'x264/0001-meson-Correctly-enable-high-bit-depth-support.patch'
    ]

    meson_options = {}

    files_libs = ['libx264']
    files_bins = ['x264']
    files_devel = ['%(libdir)s/pkgconfig/x264.pc', 'include/x264.h',
                   'include/x264_config.h']

    def prepare(self):
        if self.config.target_platform == Platform.ANDROID:
            self.meson_options['cli'] = 'false'
            self.files_bins.remove('x264')

    def post_install(self):
        LibtoolLibrary('x264', 165, None, None, self.config.libdir,
                self.config.target_platform).save()
        super().post_install()
