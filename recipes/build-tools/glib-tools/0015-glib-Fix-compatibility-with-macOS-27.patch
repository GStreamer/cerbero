From 6e1620c78e2c0ef24e573c529c86a8b87152f842 Mon Sep 17 00:00:00 2001
From: Amyspark <amy@centricular.com>
Date: Mon, 21 Sep 2026 14:26:06 -0300
Subject: [PATCH 15/15] glib: Fix compatibility with macOS 27

---
 meson.build | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/meson.build b/meson.build
index da3dd02..f18e66d 100644
--- a/meson.build
+++ b/meson.build
@@ -804,6 +804,11 @@ endforeach
 # wrapper around g_free()/g_free_sized() depending on whether it’s available
 glibconfig_conf.set('G_HAVE_FREE_SIZED', have_func_free_sized)
 
+# Check that pipe2() is usable; must use header on macOS/iOS/iPadOS 27+
+if host_system in ['darwin', 'ios']
+  glib_conf.set('HAVE_PIPE2', cc.has_function('pipe2', prefix : '#include <unistd.h>'))
+endif
+
 # Check that stpcpy() is usable; must use header.
 # See:
 # https://github.com/mesonbuild/meson/issues/5628.
-- 
2.55.0

