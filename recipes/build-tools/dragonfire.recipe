# -*- Mode: Python -*- vi:si:et:sw=4:sts=4:ts=4:syntax=python

class Recipe(recipe.Recipe):
    name = 'dragonfire'
    version = '0.1.5'
    stype = SourceType.GIT
    btype = BuildType.CARGO
    licenses = [{License.MPLv2: ['LICENSE.md']}]
    remotes = {'origin': 'https://gitlab.freedesktop.org/amyspark/dragonfire.git'}
    commit = 'v0.1.5'

    files_bins = ['dragonfire']

    # 0.1.4 uses vendored ar, which causes the following bugs:
    # - https://github.com/rust-lang/cargo/issues/7169 (fixed in 1.100)
    # - https://github.com/rust-lang/cargo/issues/17458
    # So `--locked` must be passed to work around both.
    def prepare(self):
        self.cargo_args.append('--locked')
